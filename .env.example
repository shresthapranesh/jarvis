# Copy to .env and fill in. Loaded by docker-compose (env_file) and by the app
# via python-dotenv. NEVER commit the real .env (it's in .gitignore/.dockerignore).
#
# Reminder: every secret here lives INSIDE the container, alongside the agent's
# code execution. Inject only what this deployment needs, and prefer
# least-privilege / rotatable tokens. See docs/DEPLOY.md.

# ── Required for the default model (google_genai:gemma-4-31b-it) ──
GOOGLE_API_KEY=

# ── Optional model providers ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Meta Model API (https://dev.meta.ai) — for meta:* models:
META_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Ollama running on the host (reachable via the compose extra_hosts entry):
# OLLAMA_HOST=http://host.docker.internal:11434

# ── Optional web search providers (agent's search() helper; falls back to DuckDuckGo keyless) ──
# Tavily (https://tavily.com) is tried first, then Brave (https://brave.com/search/api/).
TAVILY_API_KEY=
BRAVE_API_KEY=

# ── Optional chat bots (allowlist users via `python main.py config set ...` after boot) ──
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ── Storage / runtime (sane defaults are baked into the image; override only if needed) ──
# WORK_DIR=/data
# DATABASE_URL=sqlite+aiosqlite:////data/database.db
# CHECKPOINTS_DB=/data/checkpoints.db
