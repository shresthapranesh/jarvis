 "test_a_finished_run_replays_identically[automation]": [
  {
   "$tuple": [
    [
     {
      "data": "{\"text\": \"Hello, w\\u00f6rld \\ud83d\\udc4b\", \"source\": \"main\"}",
      "event": "token"
     },
     {
      "data": "{\"text\": \"no source\"}",
      "event": "token"
     },
     {
      "data": "{\"text\": \"hmm\"}",
      "event": "thinking_token"
     },
     {
      "data": "{\"node\": \"tools\", \"source\": \"main\", \"subagent\": null, \"data\": {\"tool\": \"run_cell\", \"args\": {\"code\": \"print('\\u00e9')\", \"n\": 1.0, \"big\": 1e-05}}}",
      "event": "step"
     },
     {
      "data": "{\"node\": \"model\", \"source\": \"subagent\", \"subagent\": \"researcher:0\", \"data\": \"already text\"}",
      "event": "step"
     },
     {
      "data": "{\"url\": \"https://example.com/\\u00e4\", \"phase\": \"done\", \"source\": \"main\"}",
      "event": "browser_step"
     },
     {
      "data": "{\"idx\": 2, \"role\": \"researcher\", \"task\": \"look\"}",
      "event": "worker_start"
     },
     {
      "data": "{\"idx\": \"3\", \"role\": \"coder\", \"node\": \"tools\", \"data\": [1, 2.5, null]}",
      "event": "worker_step"
     },
     {
      "data": "{\"idx\": 1.9, \"text\": \"w\"}",
      "event": "worker_token"
     },
     {
      "data": "{\"idx\": 2, \"role\": \"researcher\", \"task\": \"look\", \"result\": \"found\"}",
      "event": "worker_done"
     },
     {
      "data": "{\"id\": \"a1\", \"title\": \"Notes\", \"action\": \"created\", \"kind\": null, \"preview\": \"# Notes\"}",
      "event": "artifact"
     },
     {
      "data": "{\"id\": \"a2\", \"title\": \"Chart\", \"action\": \"updated\", \"kind\": \"image\"}",
      "event": "artifact"
     },
     {
      "data": "{\"todos\": [{\"text\": \"plan\", \"status\": \"done\"}, {\"text\": \"do\"}, {\"no\": \"text\"}, \"junk\"], \"source\": \"main\"}",
      "event": "todos_updated"
     },
     {
      "data": "{\"message_id\": \"q1\", \"text\": \"also this\", \"position\": 1}",
      "event": "queued_message"
     },
     {
      "data": "{\"message_id\": \"q1\"}",
      "event": "queued_withdrawn"
     },
     {
      "data": "{\"message_ids\": [\"q2\", 3]}",
      "event": "queued_consumed"
     },
     {
      "data": "{\"tool\": \"rm\", \"reason\": \"deletes\", \"args\": {\"path\": \"/tmp/x\"}}",
      "event": "approval_request"
     },
     {
      "data": "{\"tool\": \"gate\", \"reason\": \"r\", \"args\": \"{}\", \"approval_id\": \"ap1\", \"deferred\": true}",
      "event": "approval_request"
     },
     {
      "data": "{\"tool\": \"rm\", \"approved\": 1, \"answer\": \"yes\"}",
      "event": "approval_resolved"
     },
     {
      "data": "{\"parent_run_id\": \"p\", \"child_event\": \"node_done\", \"node_id\": \"n1\", \"output\": {\"x\": 0.1}}",
      "event": "workflow_event"
     },
     {
      "data": "{\"reason\": \"tokens\", \"limit\": 100, \"used\": 101.5}",
      "event": "budget_exceeded"
     },
     {
      "data": "{\"input_tokens\": 10, \"output_tokens\": 5, \"total_tokens\": 15, \"llm_calls\": 1, \"tool_calls\": 0, \"snapshot\": {\"elapsed_seconds\": 1.25}}",
      "event": "budget_update"
     },
     {
      "data": "{\"ttft_ms\": 350.0, \"llm_ms\": null, \"prefill_tps\": \"41.5\", \"eval_tps\": 38.123456789, \"llm_calls\": 1}",
      "event": "perf_update"
     },
     {
      "data": "{\"x\": 1}",
      "event": "not_a_chat_event"
     },
     {
      "data": "{\"message\": \"All done \\u2713\", \"conversation_id\": \"c1\"}",
      "event": "done"
     },
     {
      "data": "{\"node_id\": \"n1\", \"node_type\": \"agent\", \"label\": \"Research\"}",
      "event": "node_start"
     },
     {
      "data": "{\"node_id\": \"n1\", \"text\": \"t\"}",
      "event": "node_token"
     },
     {
      "data": "{\"node_id\": \"c\", \"verdict\": true}",
      "event": "node_condition"
     },
     {
      "data": "{\"node_id\": \"n1\", \"output\": {\"result\": \"ok\", \"score\": 0.5, \"nested\": {\"a\": [1]}}}",
      "event": "node_done"
     },
     {
      "data": "{\"node_id\": \"n2\", \"output\": null}",
      "event": "node_done"
     },
     {
      "data": "{\"node_id\": \"n3\", \"error\": \"boom\"}",
      "event": "node_error"
     },
     {
      "data": "{\"node_id\": \"m\", \"total\": \"3\"}",
      "event": "map_start"
     },
     {
      "data": "{\"node_id\": \"m\", \"index\": 0, \"result\": {\"v\": 1}}",
      "event": "map_item_done"
     },
     {
      "data": "{\"tool\": \"approve\", \"reason\": \"ok?\", \"args\": {\"k\": \"v\"}}",
      "event": "approval_request"
     },
     {
      "data": "{\"tool\": \"approve\", \"reason\": \"ok?\", \"args\": \"raw\", \"node_id\": \"ap\"}",
      "event": "approval_request"
     },
     {
      "data": "{\"tool\": \"approve\", \"approved\": true, \"answer\": \"yes\", \"node_id\": \"\"}",
      "event": "approval_resolved"
     },
     {
      "data": "{\"interrupt_id\": \"i\", \"question\": \"q\"}",
      "event": "interrupt"
     },
     {
      "data": "{\"interrupt_id\": \"i\"}",
      "event": "interrupt_resolved"
     },
     {
      "data": "{\"reason\": \"calls\", \"snapshot\": {\"calls\": 9}}",
      "event": "budget_exceeded"
     },
     {
      "data": "{\"input_tokens\": 1, \"output_tokens\": 2, \"total_tokens\": 3, \"llm_calls\": 1, \"tool_calls\": 0}",
      "event": "budget_update"
     },
     {
      "data": "{\"node_id\": \"n1\", \"attempt\": 1, \"max_retries\": 3, \"error\": \"flaky\"}",
      "event": "node_retry"
     },
     {
      "data": "{\"text\": \"not a workflow event\"}",
      "event": "token"
     },
     {
      "data": "{\"outputs\": {\"answer\": 42}, \"run_id\": \"wr\"}",
      "event": "workflow_done"
     }
    ],
    [
     {
      "data": {
       "automationRunEvents": {
        "__typename": "TokenEvent",
        "source": "main",
        "text": "Hello, wörld 👋"
       }
      }
     },
     {
      "data": {
       "automationRunEvents": {
        "__typename": "TokenEvent",
        "source": "main",
        "text": "no source"
       }
      }
     },
     {
      "data": {
       "automationRunEvents": {
        "__typename": "AutomationDoneEvent",
        "output": null,
        "runId": ""
       }
      }
     },
     {
      "data": {
       "automationRunEvents": {
        "__typename": "TokenEvent",
        "source": "main",
        "text": "not a workflow event"
       }
      }
     }
    ]
   ]
  }
 ],
